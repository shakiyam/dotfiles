[user]
	useConfigOnly = true
[credential]
	helper = cache
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	line-numbers = true
	side-by-side = true
	syntax-theme = Monokai Extended
[merge]
	conflictStyle = zdiff3
[log]
	decorate = true
