[user]
	useConfigOnly = true
[credential]
	helper = cache
# Let gh supply GitHub credentials instead of the cache: the empty helper clears inherited ones,
# and `gh auth setup-git` is avoided because it writes gh's absolute path, which changes when mise updates gh
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	line-numbers = true
	side-by-side = true
	syntax-theme = Monokai Extended
[merge]
	conflictStyle = zdiff3
[log]
	decorate = true
