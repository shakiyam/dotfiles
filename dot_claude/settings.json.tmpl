{{- /* herdr finds its hook by absolute path; writing "~" makes a reinstall register a duplicate */ -}}
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(env:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(make flake8:*)",
      "Bash(make hadolint:*)",
      "Bash(make lint:*)",
      "Bash(make mypy:*)",
      "Bash(make rubocop:*)",
      "Bash(make shellcheck:*)",
      "Bash(make shfmt:*)",
      "Bash(make test:*)",
      "Bash(pwd)",
      "Bash(tail:*)",
      "Bash(type:*)",
      "Bash(wc:*)",
      "Bash(which:*)"
    ],
{{- /* These prefix rules miss rewritten forms such as `git -C <repo> push`; the
bash-guard.py PreToolUse hook blocks those. The rules stay as a fallback for when
hooks are disabled. */}}
    "deny": [
      "Bash(git push:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(eval:*)"
    ],
    "defaultMode": "auto"
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "hooks": {"PreToolUse":[{"matcher":"Bash","hooks":[{"type":"command","command":"python3 -I '{{ .chezmoi.homeDir }}/.claude/hooks/bash-guard.py'","timeout":10,"onFailure":"block"}]}],"SessionStart":[{"matcher":"^(startup|resume|clear|compact|fork)$","hooks":[{"type":"command","command":"bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session","timeout":10}]}]}
}
